#!/usr/bin/env bash
#
# Pre-commit hook for cpuaff. Wire up via `tools/setup-hooks.sh`.
#
# Runs the same hygiene gates that CI enforces:
#   * tools/leakcheck.sh   — local paths / internal refs
#   * gitleaks (if on PATH) — credential patterns

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

tools/leakcheck.sh --staged

if command -v gitleaks >/dev/null 2>&1; then
    gitleaks protect --staged --redact
fi
